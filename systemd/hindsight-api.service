# systemd user unit (template scaffold)
# Install later to: ~/.config/systemd/user/hindsight-api.service

[Unit]
Description=Hindsight API (local)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/code/dev/hindsight-highlights
EnvironmentFile=%h/code/dev/hindsight-highlights/env/hindsight.env
ExecStart=%h/code/dev/hindsight-highlights/.venv/bin/hindsight-api --host ${HINDSIGHT_API_HOST} --port ${HINDSIGHT_API_PORT}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
