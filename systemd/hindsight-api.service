[Unit]
Description=Hindsight API (local system service)
Documentation=file:/home/poop/code/dev/hindsight-highlights/docs/PLAN.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=poop
Group=poop
WorkingDirectory=/home/poop/code/dev/hindsight-highlights
SELinuxContext=-unconfined_u:unconfined_r:unconfined_t:s0
ExecStart=/usr/bin/bash -lc 'set -a; source /home/poop/code/dev/hindsight-highlights/env/hindsight.env; set +a; exec /home/poop/code/dev/hindsight-highlights/.venv/bin/hindsight-api --host "$HINDSIGHT_API_HOST" --port "$HINDSIGHT_API_PORT"'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
