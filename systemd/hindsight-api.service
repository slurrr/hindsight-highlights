# systemd user unit
# Install with: ./scripts/install-user-service.sh

[Unit]
Description=Hindsight API (local)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/code/dev/hindsight-highlights
EnvironmentFile=%h/code/dev/hindsight-highlights/env/hindsight.env
ExecStartPre=/usr/bin/mkdir -p %h/runs/hindsight
ExecStart=%h/code/dev/hindsight-highlights/scripts/run-api.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
