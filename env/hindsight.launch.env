# Hindsight launch defaults (manual start profile)
#
# This file is loaded by scripts/run-api.sh after env/hindsight.env so launch-time
# values can override the service defaults without mixing the concerns together.

# Optional launch defaults for starting a memory LLM stack alongside Hindsight.
# Hindsight itself does not start vLLM unless `hindsight up --llm` is used.
HINDSIGHT_LLM_DEFAULT_STACK=mem_gem_hsx
HINDSIGHT_LLM_MODEL=gemma-4-e4b-memory
HINDSIGHT_LLM_BASE_URL=http://127.0.0.1:8002/v1
HINDSIGHT_LLM_HEALTH_URL=http://127.0.0.1:8002/health
HINDSIGHT_LLM_START_TIMEOUT=600
HINDSIGHT_LLM_START_INTERVAL=2
