# hindsight-highlights: authoritative local service env
# NOTE: keep this non-secret (local dev defaults). If you later need secrets,
# add env/hindsight.local.env and ignore it in git.

# Bind
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888

# Caches
XDG_CACHE_HOME=/home/poop/cache
HF_HOME=/home/poop/models/hf

# Database (system postgres on localhost)
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:hindsight@127.0.0.1:5432/hindsight
HINDSIGHT_API_MIGRATION_DATABASE_URL=postgresql://hindsight:hindsight@127.0.0.1:5432/hindsight

# LLM runtime defaults (launch wrapper may override per-run; see env/hindsight.launch.env)
# `auto` is handled by scripts/run-api.sh: it queries the OpenAI-compatible
# /v1/models endpoint on 127.0.0.1:8002 and exports the returned model id before
# starting Hindsight. This lets the 8002 memory slot use the actual served model
# name instead of requiring every backend to share a generic alias.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=auto
HINDSIGHT_API_LLM_API_KEY=dummy
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:8002/v1
# Pinned TabbyAPI only returns usage for chat completions when this request option is set,
# including for non-streaming calls. Required for Hindsight token metrics until Tabby is fixed.
HINDSIGHT_API_LLM_EXTRA_BODY='{"stream_options":{"include_usage":true}}'

# Timeouts / stability defaults (tune later)
HINDSIGHT_API_LLM_TIMEOUT=600
HINDSIGHT_API_RETAIN_LLM_TIMEOUT=600
HINDSIGHT_API_CONSOLIDATION_LLM_TIMEOUT=600
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=8

# Retrieval defaults (align to Hindsight defaults unless you intentionally tune)
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=false
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_FORCE_CPU=false
HINDSIGHT_API_RERANKER_LOCAL_BATCH_SIZE=32
HINDSIGHT_API_RERANKER_LOCAL_MAX_CONCURRENT=4
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=300
HINDSIGHT_API_LAZY_RERANKER=false

# Observability (upstream Grafana LGTM stack: `hindsight monitoring`)
HINDSIGHT_API_METRICS_INCLUDE_BANK_ID=true
HINDSIGHT_API_OTEL_TRACES_ENABLED=true
HINDSIGHT_API_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
HINDSIGHT_API_OTEL_SERVICE_NAME=hindsight-local
HINDSIGHT_API_OTEL_DEPLOYMENT_ENVIRONMENT=local
